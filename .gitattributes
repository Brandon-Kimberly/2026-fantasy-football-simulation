# The tamper-evidence guard hashes these files byte-for-byte; autocrlf conversion on
# checkout would rewrite LF->CRLF and trip it as a false alarm. Pin them binary-stable.
SEASON_2026_EVALUATION.md -text
SEASON_2026_EVALUATION.sha256 -text

# Append-only jsonl logs: merge=union instead of conflicts when a local sync and the
# scheduled Actions capture race. Verified safe PER LOG, not assumed (2026-09-04):
#   projection_log      -- readers keep the last row per (season, week, player_id);
#                          concurrent same-key rows are both-valid captures minutes apart
#   predictions_*.jsonl -- readers keep the last (canonical-preferred) row per (season, week)
#   decision_log        -- ingestion dedupes on transaction_id AND every reader dedupes
#                          first-row-wins (added for exactly this; pinned by tests)
#   points_backtest     -- append-only per-run records, compared line-by-line
#   designations        -- every reader keys into a SET (weeks_by_pid[pid].add(wk), the
#                          roll call's {week: {pid}}), so a duplicate row is absorbed; only
#                          the CLI's cosmetic row count moves (added 2026-09-24)
#   sync_provenance     -- append-only provenance; its one reader builds a set of stamps
#   first_recorded_scores -- union ALONE was not safe here. The log exists to freeze the
#                          FIRST score seen per (week, name) -- the basis of the F83
#                          reconstruction -- and both readers took the LAST row, so union
#                          would have returned the second capture and inverted exactly the
#                          guarantee. Readers are first-row-wins as of F87, same treatment
#                          decision_log got; pinned by tests.
#
# NOT unioned, deliberately: bid_ledger.jsonl has no automated writer (owner-run only), so
# it cannot race. streamer_levels.jsonl was excused the same way until 2026-09-29, when it
# conflicted: weekly_report records a reading on every run since C5, the runner's included. data/logs also holds whole-document .json
# (draft_*, season_*) -- union there would concatenate two documents into unparseable JSON,
# which is why the patterns are *.jsonl and never data/logs/*.
# tests/test_log_merge_strategy.py guards this list: a new tracked jsonl log must carry the
# attribute or be named in its exclusion set. The list went stale once already.
data/logs/projection_log.jsonl merge=union
data/logs/decision_log.jsonl merge=union
data/logs/predictions_*.jsonl merge=union
data/logs/points_backtest.jsonl merge=union
data/logs/designations.jsonl merge=union
data/logs/sync_provenance.jsonl merge=union
data/logs/first_recorded_scores.jsonl merge=union
#   faab_adjustments    -- written by warn_faab_adjustments inside sync, so it races like
#                          the rest. Deduped on (week, team, delta) at WRITE time, and every
#                          reader keys by (team, week) taking the series in order, so a
#                          duplicate row from a union merge is absorbed (B28)
data/logs/faab_adjustments.jsonl merge=union
#   failed_claims       -- the lost waiver claims (Decision 4, 2026-09-29), written inside sync.
#                          Deduped on transaction_id at WRITE time, and its one reader
#                          (webui.players_page._contested) keeps the first row per
#                          transaction_id, so a duplicate from a union merge is absorbed;
#                          pinned by tests.test_webui_bids
data/logs/failed_claims.jsonl merge=union
#   streamer_levels     -- one timestamped C5 reading per weekly_report run (2026-09-29). Its
#                          only reader is the log viewer, so a duplicate from a union merge
#                          is one reading shown twice, never a wrong number
data/logs/streamer_levels.jsonl merge=union
#   scoring_settings    -- the league's scoring settings over time (fantasy_sim.banked_scores),
#                          appended by the sync when they change, so it races like the rest. Its
#                          reader sorts by observed_at and absorbs a repeat of the settings in
#                          force, so a duplicate from a union merge changes nothing; pinned by
#                          tests.test_banked_scores
data/logs/scoring_settings.jsonl merge=union
