# All runtime output -- synced data, simulation exports, charts, logs, backtest artifacts.
# Nothing in here is source; it's all regenerated by running the scripts in scripts/.
data/*
backtest_workdir/

# Python
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.pytest_cache/

# Environment / credentials -- ODDS_API_KEY, ESPN_S2, ESPN_SWID are read from the environment
# (see fantasy_sim/config.py), never hardcoded, but keep any local .env file out regardless.
.env
.venv/
venv/

# Editor/OS cruft
.vscode/
.idea/
.DS_Store

# Hypothesis property-testing cache (tests/test_invariants.py)
.hypothesis/

# coverage.py data file (regenerable local artifact; the committed floor is coverage_floor.txt)
.coverage

# Git will not apply a nested !-exception if a parent directory is itself excluded by the
# blanket "data/*" rule above -- the directory has to be un-excluded first, THEN the file
# inside it. (Documented here because the flat-layout version of this exception was already
# gotten wrong once and had to be corrected after verifying against a real commit -- see
# AUDIT_PLAN.md F7.)
!data/logs/
!data/logs/projection_log.jsonl
# F2 criterion (c): the points-level backtest's append-only result log, one JSON line per run
# stamped with commit + interpreter (scripts/run_points_backtest.py). Tracked so a
# before/after comparison is a diff of two committed lines.
!data/logs/points_backtest.jsonl
# The decision log: every real roster move with its projection snapshot at ingestion --
# cannot be reconstructed after the fact (same reason as the projection log above).
!data/logs/decision_log.jsonl
# F15: the league's real draft history, one immutable document per season
# (sync.ingest_drafts). Historical record -- Sleeper ages drafts out, so once written the
# on-disk file is the source. The nested-exception rule above applies: data/logs/ is already
# un-excluded, so this pattern works; verified against a real commit like the others.
!data/logs/draft_*.json
# The season-retrospective bundle: a completed season's real matchups with per-player
# realized scores (sync.ingest_season). Same reasoning -- Sleeper ages seasons out, so
# once written the on-disk file is the source; verified against a real commit.
!data/logs/season_*.json
# The weekly prediction record (weekly_report.append_predictions_log): what the model said
# BEFORE each week -- F18/F19's origin data. data/weeks/ holds the same forecast untracked;
# this is the copy that survives a machine loss. Verified against a real commit.
!data/logs/predictions_*.jsonl
# C5: BASE_STREAMER_MEANS against the live free-agent pool, one row per run. Tracked
# for the same reason as the others -- it CANNOT be reconstructed after the fact. That
# is the finding: projection_log.jsonl is one line per ROSTERED player, so a season-long
# free agent never appears in it and no past pool can be rebuilt. Positions and numbers
# only; no identities.
!data/logs/streamer_levels.jsonl

# The sanitized sample is a BUILD PRODUCT since 2026-09-05: generated and deployed to
# Pages by .github/workflows/pages-sample.yml, never committed (9MB per copy was
# growing the repo permanently). Local generations land here and stay untracked.
docs/sample/

# H3: stray run logs. A `git add -A` after `py -3.10 -m ... > foo.log` sweeps these up;
# it has happened three times (w.log, collins.log, ev.log). ROOT-ANCHORED on purpose --
# an unanchored *.log would also swallow anything under data/logs/ if a future record is
# ever written with that extension. tests/test_docs pins both halves.
/*.log

# H1: scripts/scan_real_names' local allowlist of adjudicated false positives. It holds
# word fragments the owner has judged to be coincidences, which means it holds fragments
# OF REAL NAMES -- committing it would be the leak the scanner exists to prevent.
# tests/test_real_name_scan pins this line.
.real_name_scan_allow
